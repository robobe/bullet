{
  "folders": [
    {
      "path": "bullet_render"
    },
    {
      "path": "mcap_bagger"
    },
    {
      "path": "bullet_drone"
    },
    {
      "name": "docs",
      "path": "docs"
    },
    {
      "path": "bullet_msgs"
    },
    {
      "path": "los_tracking"
    },
    {
      "path": "bullet_app"
    },
    {
      "path": "msp_link"
    },
    {
      "path": "flight_lens"
    }
  ],
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Bullet: Run all",
        "type": "process",
        "command": "bash",
        "args": [
          "-c",
          "set -e\npython3 tools/cleanup_flight.py\ncmake --preset debug\ncmake --build --preset debug\nexec uv run --locked --all-packages --all-extras --all-groups python tools/run_flight.py\n"
        ],
        "options": {
          "cwd": "${workspaceFolder:bullet_render}"
        },
        "problemMatcher": [
          "$gcc"
        ],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true
        },
        "runOptions": {
          "instanceLimit": 1
        },
        "detail": "Build renderer and launch recorded flight services. One MCAP per flight, process logs per launch. Wait for Mission READY, then press Start."
      },
      {
        "label": "FlightLens: Open",
        "type": "process",
        "command": "uv",
        "args": [
          "run",
          "--locked",
          "--all-packages",
          "--all-extras",
          "--all-groups",
          "flight-lens"
        ],
        "options": {
          "cwd": "${workspaceFolder:flight_lens}"
        },
        "problemMatcher": []
      },
      {
        "label": "Bullet: Build Betaflight SITL",
        "type": "process",
        "command": "bash",
        "args": [
          "tools/setup_betaflight_sitl.sh"
        ],
        "options": {
          "cwd": "${workspaceFolder:bullet_drone}"
        },
        "problemMatcher": [
          "$gcc"
        ]
      },
      {
        "label": "Bullet: Run all (custom MCAP directory)",
        "type": "process",
        "command": "bash",
        "args": [
          "-c",
          "set -e\npython3 tools/cleanup_flight.py\ncmake --preset debug\ncmake --build --preset debug\nexec uv run --locked --all-packages --all-extras --all-groups python tools/run_flight.py --mcap-output-dir ~/workspaces/bullet/recordings\n"
        ],
        "options": {
          "cwd": "${workspaceFolder:bullet_render}"
        },
        "problemMatcher": [
          "$gcc"
        ],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true
        },
        "runOptions": {
          "instanceLimit": 1
        },
        "detail": "Build and launch the flight services; save MCAP files to ~/workspaces/bullet/recordings. Wait for Mission READY, then press Start."
      }
    ]
  }
}
