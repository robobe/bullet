{
  "folders": [
    {
      "name": "config",
      "path": "config"
    },
    {
      "path": "bullet_render"
    },
    {
      "path": "mcap_bagger"
    },
    {
      "path": "bullet_drone"
    },
    {
      "name": "docs",
      "path": "docs"
    },
    {
      "path": "bullet_msgs"
    },
    {
      "path": "los_tracking"
    },
    {
      "path": "bullet_app"
    },
    {
      "path": "msp_link"
    },
    {
      "path": "flight_lens"
    },
    {
      "path": "bullet_view"
    }
  ],
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Bullet: Run all",
        "type": "process",
        "command": "bash",
        "args": [
          "-c",
          "set -e\ncase '${input:flightProfile}' in\n  internal)\n    physics_config=../config/internal.yaml\n    mission_config=../config/bullet_profile.yaml\n    ;;\n  betaflight)\n    physics_config=../config/betaflight.yaml\n    mission_config=../config/betaflight_los.yaml\n    ;;\n  *) echo 'Unknown flight profile' >&2; exit 2 ;;\nesac\npython3 tools/cleanup_flight.py\ncmake --preset debug\ncmake --build --preset debug\nuv run --locked --package bullet-view bullet-view &\nbullet_view_pid=$!\ntrap 'kill \"$bullet_view_pid\" 2>/dev/null || true' EXIT\nuv run --locked --all-packages --all-extras --all-groups python tools/run_flight.py --physics-config \"$physics_config\" --mission-config \"$mission_config\" --mcap-output-dir ~/workspaces/bullet/recordings\n"
        ],
        "options": {
          "cwd": "${workspaceFolder:bullet_render}"
        },
        "problemMatcher": [
          "$gcc"
        ],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true
        },
        "runOptions": {
          "instanceLimit": 1
        },
        "detail": "Select Internal or Betaflight to load its matching physics and mission profiles. Save MCAP files to ~/workspaces/bullet/recordings. Wait for Mission READY, then press Start."
      },
      {
        "label": "FlightLens: Open",
        "type": "process",
        "command": "uv",
        "args": [
          "run",
          "--locked",
          "--all-packages",
          "--all-extras",
          "--all-groups",
          "flight-lens"
        ],
        "options": {
          "cwd": "${workspaceFolder:flight_lens}"
        },
        "problemMatcher": []
      },
      {
        "label": "Bullet View: Open",
        "type": "process",
        "command": "uv",
        "args": [
          "run",
          "--locked",
          "--package",
          "bullet-view",
          "bullet-view"
        ],
        "options": {
          "cwd": "${workspaceFolder:bullet_view}"
        },
        "problemMatcher": []
      },
      {
        "label": "Bullet: Build Betaflight SITL",
        "type": "process",
        "command": "bash",
        "args": [
          "tools/setup_betaflight_sitl.sh"
        ],
        "options": {
          "cwd": "${workspaceFolder:bullet_drone}"
        },
        "problemMatcher": [
          "$gcc"
        ]
      }
    ],
    "inputs": [
      {
        "id": "flightProfile",
        "type": "pickString",
        "description": "Select the backend and matching profiles",
        "options": [
          "internal",
          "betaflight"
        ],
        "default": "betaflight"
      }
    ]
  }
}
